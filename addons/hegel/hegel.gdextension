[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/hegel/bin/libhegel_gdscript.linux.x86_64.so"
linux.release.x86_64 = "res://addons/hegel/bin/libhegel_gdscript.linux.x86_64.so"
windows.debug.x86_64 = "res://addons/hegel/bin/hegel_gdscript.windows.x86_64.dll"
windows.release.x86_64 = "res://addons/hegel/bin/hegel_gdscript.windows.x86_64.dll"
macos.debug.arm64 = "res://addons/hegel/bin/libhegel_gdscript.macos.arm64.dylib"
macos.release.arm64 = "res://addons/hegel/bin/libhegel_gdscript.macos.arm64.dylib"

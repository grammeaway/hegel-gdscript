; Development project for hegel-gdscript's tests and examples. Not shipped.

config_version=5

[application]

config/name="hegel-gdscript"
config/features=PackedStringArray("4.7")

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/directory_rules={
"res://addons": 0,
"res://addons/hegel": 1
}

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")
